# 3awedlou mobile — copy to .env and adjust per environment.
#
# PHYSICAL DEVICE TESTING (Expo Go): localhost on the phone is the phone
# itself. Set your computer's LAN IP below so the app reaches the Symfony
# backend running on your dev machine (find it with `ipconfig` / `ip addr`).
# Android emulators may use http://10.0.2.2:8000/api instead.
#
# Never put secrets here — EXPO_PUBLIC_* values are embedded in the app bundle.

EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000/api
EXPO_PUBLIC_REALTIME_URL=
EXPO_PUBLIC_ENVIRONMENT=development
