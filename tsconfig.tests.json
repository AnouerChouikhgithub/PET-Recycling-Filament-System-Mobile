{
  "//": "Compiles the PURE modules (no React Native, no Expo) so they can be exercised by node --test in __tests__/. See README: AI assistant.",
  "compilerOptions": {
    "target": "ES2021",
    "module": "node16",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "types": [],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "lib/agentContract.ts",
    "lib/alerts.ts",
    "lib/commandDelivery.ts",
    "lib/machineView.ts",
    "lib/telemetryFreshness.ts"
  ]
}
